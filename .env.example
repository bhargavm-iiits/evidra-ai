# Copy this file to .env and fill in your key.
# Leave CLAIMBRIDGE_LLM_MODE=template to run the whole app with no API key.

CLAIMBRIDGE_LLM_MODE=template

# Which live backend structured() uses when LLM_MODE=live. "anthropic" or "gemini".
CLAIMBRIDGE_LLM_PROVIDER=anthropic

# --- Anthropic (used when CLAIMBRIDGE_LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Gemini (used when CLAIMBRIDGE_LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=...
# Optional, defaults to gemini-2.5-flash:
# CLAIMBRIDGE_GEMINI_MODEL=gemini-2.5-flash
